# Copy to .env for local development. Never commit .env.
# In staging and production these come from AWS Secrets Manager (Doc 12 §6).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

DATABASE_URL=postgres://agricrm:agricrm_dev_only@localhost:5433/agricrm
REDIS_URL=redis://localhost:6380/0

# --- Staging / production only -------------------------------------------
# 🔴 ap-south-1 only. Data residency is a compliance position (Doc 03 §7).
# AWS_REGION=ap-south-1
# S3_BUCKET=
# SENTRY_DSN=

# --- Messaging (Phase 4) --------------------------------------------------
# Dev uses mock backends; these stay empty until Meta verification completes.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
