# Copy to .env for local development. Never commit .env.
# In staging and production these come from AWS Secrets Manager (Doc 12 §6).

# 🔴 Signs every JWT (HS256). The service refuses to start with the
# development default when DEBUG is off.
#
# `DJANGO_SECRET_KEY` is still read as a fallback so environments configured
# before the rename keep working — but they are signing with the same key
# under a different name, so set this one and delete that one together.
# Changing the value logs every user out; it is a rotation, not an edit.
API_SECRET_KEY=dev-only-change-me
DEBUG=True
LOG_LEVEL=INFO

DATABASE_URL=postgres://agricrm:agricrm_dev_only@localhost:5433/agricrm

# Where the test suite runs. Optional: unset, the tests use DATABASE_URL.
#
# 🔴 Worth setting when DATABASE_URL points at a hosted database. The suite
# applies the real schema and writes through every model, so running it against
# a database across the network is slow and inherits that network's flakiness —
# a resolver that refuses one lookup in five turns into a test that fails one
# run in seven, which is the worst kind of red. Point this at the local
# container and the suite is exercising the same DDL either way.
# TEST_DATABASE_URL=postgres://agricrm:agricrm_dev_only@localhost:5433/agricrm
REDIS_URL=redis://localhost:6380/0

# --- Staging / production only -------------------------------------------
# 🔴 ap-south-1 only. Data residency is a compliance position (Doc 03 §7).
# AWS_REGION=ap-south-1
# S3_BUCKET=
# SENTRY_DSN=

# --- Messaging (Phase 4) --------------------------------------------------
# Dev uses mock backends; these stay empty until Meta verification completes.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# --- Invoice extraction agent (INVOICE.md) -------------------------------
# Reads an uploaded invoice photo or PDF and fills the create form.
# Optional: with no key the upload endpoint refuses cleanly and the form is
# typed by hand. 🔴 Never commit a real key — this file is the template.
#
# Two providers are supported. Pick one:
#   anthropic  — needs ANTHROPIC_API_KEY.  pip install anthropic
#   nvidia     — needs NVIDIA_API_KEY.     OpenAI-compatible, no extra package
INVOICE_EXTRACTION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=
# NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# --- 🔴 Development-only: turn authentication OFF ------------------------
# Every API request is treated as one fixed low-privilege user and the login
# screen is skipped. For looking at the app before there is data in it.
#
# A switch, not a deletion — auth, MFA and roles are all still there. Delete
# the line to get them back.
#
# 🔴 The service refuses to start with this set and DEBUG off — see
# `startup_problems()` in backend/main.py. R11 applies: never point an instance running this at production data.
# Set VITE_NO_AUTH=1 in frontend/.env to match.
# DEV_NO_AUTH=1

# --- 🔴 Development-only: skip the second factor -------------------------
# Privileged roles sign in with a password alone — no authenticator app.
# Narrower than DEV_NO_AUTH above: the password is still checked and roles
# still apply; only the TOTP step is skipped. The service refuses to start
# with this set and DEBUG off. 🔴 R11: never with real data.
# DEV_NO_MFA=1

# --- Collectors (Doc 05, R1-R4) ------------------------------------------
# Goes in the User-Agent of every collector request, so a site operator can
# reach a human. R2 requires it.
COLLECTOR_CONTACT_EMAIL=data@thetaanalytics.in

# Optional. Routes collector requests through Scrapfly for a stable egress IP.
# 🔴 The anti-bot (ASP) and CAPTCHA features stay OFF — R3 forbids them, and
# collectors/fetch.py sends them explicitly false. Scrapfly is a fetcher here,
# not a way past a site that does not want to be read.
SCRAPFLY_API_KEY=

# =========================================================================
# The advanced invoice module (INVOICE.md §12–13)
#
# 🔴 Every provider below defaults to a deterministic fake, and that is not a
# placeholder — the fakes are what the safety tests run against. They cost
# nothing, need no credentials, and cannot reach a real customer, so the
# assertions that matter (a duplicate webhook cannot create a second payment,
# an opt-out outranks a send, the copilot cannot issue) run on every commit.
#
# Naming a real provider without its credentials raises at startup rather than
# falling back. A silent fallback would mean a deployment that believes it is
# calling a live service while a fixture answers.
# =========================================================================

# --- Object storage -------------------------------------------------------
# Uploaded documents, rendered PDFs and raw webhook bodies. Content-addressed
# by sha256, indexed in crm.stored_object, with retention per purpose.
STORAGE_BACKEND=local
# STORAGE_ROOT defaults to var/storage under the repo. Set a bucket for S3:
# STORAGE_BACKEND=s3
# STORAGE_BUCKET=
# STORAGE_PREFIX=invoices

# --- Invoice copilot (INVOICE.md §12.3) -----------------------------------
# `fake` is a rule-based proposer, not a stub. It abstains rather than guesses
# and the evaluation suite scores it, so the trust boundary is exercised in CI.
COPILOT_PROVIDER=fake
# COPILOT_PROVIDER=anthropic   # then ANTHROPIC_API_KEY below is required
COPILOT_MODEL=claude-opus-5
COPILOT_PROMPT_VERSION=v1
# How long a human has to confirm a proposal. Short on purpose: the point of
# the hash binding is that the world may have moved on.
COPILOT_PROPOSAL_TTL_MINUTES=30

# --- GSTIN verification (INVOICE.md §12.4) --------------------------------
# 🔴 `fake` until a GSP contract exists. Do NOT point this at the public GST
# portal: R3 forbids defeating a site's protections, and a site that cannot be
# read without doing so is telling you to buy a licence instead.
GSTIN_LOOKUP_PROVIDER=fake
# GSTIN_LOOKUP_PROVIDER=http
# GSTIN_LOOKUP_BASE_URL=
# GSTIN_LOOKUP_API_KEY=
GSTIN_CACHE_TTL_HOURS=168
# Beyond this a cached verification is stale and the UI says so.
GSTIN_STALE_AFTER_DAYS=30

# --- Delivery (INVOICE.md §12.5) ------------------------------------------
# The fake records what would have been sent; nothing leaves the building.
EMAIL_PROVIDER=fake
# EMAIL_PROVIDER=smtp
EMAIL_FROM=billing@thetaanalytics.in
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

WHATSAPP_PROVIDER=fake
# 🔴 WHATSAPP_APP_SECRET verifies the signature on inbound webhooks. Without
# it the endpoint accepts nothing, which is correct — an endpoint that accepts
# unsigned events is an open write endpoint on the internet.
# WHATSAPP_VERIFY_TOKEN=

# --- Payments (INVOICE.md §12.5) ------------------------------------------
# 🔴 A payment request is never a payment. A UPI link and QR sit at
# `awaiting_manual_confirmation` until a human records the receipt or a
# signed, matched gateway webhook arrives.
PAYMENT_GATEWAY_PROVIDER=fake
# PAYMENT_GATEWAY_KEY=
# PAYMENT_GATEWAY_SECRET=
# Signs and verifies webhook payloads over the raw request bytes.
PAYMENT_WEBHOOK_SECRET=dev-only-change-me
# How old a signed event may be before it is treated as a replay.
WEBHOOK_REPLAY_WINDOW_SECONDS=300
# The VPA a manual UPI request pays into. Empty disables manual UPI rather
# than generating a link that goes nowhere.
# UPI_VPA=
# UPI_PAYEE_NAME=

# --- Tests ----------------------------------------------------------------
# 🔴 Worth setting when DATABASE_URL points at a hosted database. The suite
# applies the real schema and writes through every model, so running it across
# the network is slow and inherits that network's flakiness — a resolver that
# refuses one lookup in five becomes a test that fails one run in seven.
# TEST_DATABASE_URL=postgres://agricrm:agricrm_dev_only@localhost:5433/agricrm

# --- Billing entity details ----------------------------------------------
# 🔴 Never commit real values here. `backend/seeds.py` falls back to visible
# placeholders, so the project runs without them and any invoice it renders
# is obviously not payable. Fill these in locally (in .env, not this file)
# to reproduce the real documents.
TFD_BANK_ACCOUNT_NO=
TEPL_BANK_ACCOUNT_NO=
BILLING_CONTACT_PHONE=
TFD_CONTACT_NAME=
TFD_SIGNATORY_NAME=
