# Local development needs nothing here — vite.config.ts proxies /api to
# http://127.0.0.1:8001 (FastAPI) by default.

# Point the dev proxy somewhere else (a colleague's backend, a Render preview):
# VITE_DEV_API=https://agricrm-api.onrender.com

# Only set this if you are NOT using the Vercel rewrite in vercel.json and
# want the browser to call the API cross-origin. Leaving it empty keeps
# requests same-origin, which is the intended setup.
# VITE_API_URL=

# 🔴 Development-only: skip the login screen. Must be paired with
# DEV_NO_AUTH=1 on the backend, or the UI renders and every call returns 401.
# Compile-time — a production build drops the branch entirely.
# VITE_NO_AUTH=1
#
# 🔴 Put it in `.env.development`, never in `.env`. Vite loads `.env` for every
# mode including `npm run build`, so the flag here would compile the bypass
# into a production bundle. `.env.development` is dev-mode only — verified:
# a normal build keeps the login page, a VITE_NO_AUTH=1 build drops it.
